{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/project-access-policy.schema.json",
  "Statements": [
    {
      "Sid": "deny_direct_cloud_save_writes",
      "Action": ["Write"],
      "Effect": "Deny",
      "Principal": "Player",
      "Resource": "urn:ugs:cloud-save:/v1/data/projects/*/players/*/items**",
      "Version": "1.0.0"
    },
    {
      "Sid": "deny_direct_leaderboard_score_writes",
      "Action": ["Write"],
      "Effect": "Deny",
      "Principal": "Player",
      "Resource": "urn:ugs:leaderboards:/v1/projects/*/leaderboards/*/scores/players/*",
      "Version": "1.0.0"
    }
  ]
}
